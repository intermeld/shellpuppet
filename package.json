{
  "name": "shellpuppet",
  "version": "0.1.0",
  "description": "Supervised terminal sessions for AI agents: an agent drives a real terminal while you watch, type and approve. Like Playwright, but for the terminal. An MCP server and CLI over a per-user daemon, with a live browser viewer on the same session.",
  "license": "Apache-2.0",
  "author": "Red Eagle Tech Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intermeld/shellpuppet.git"
  },
  "homepage": "https://github.com/intermeld/shellpuppet#readme",
  "bugs": {
    "url": "https://github.com/intermeld/shellpuppet/issues"
  },
  "keywords": [
    "terminal",
    "pty",
    "mcp",
    "ai-agents",
    "supervision",
    "tui",
    "agent-cli"
  ],
  "type": "module",
  "bin": {
    "shellpuppet": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-viewer-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "chrome-launcher": "^1.2.2",
    "node-pty": "1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
